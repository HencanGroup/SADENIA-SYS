# =============================================================================
# SADENIA SYSTEMS — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in the values.
# Never commit .env.local to version control.

# -----------------------------------------------------------------------------
# Email — SMTP (shared hosting / Roundcube)
# -----------------------------------------------------------------------------
# Use your hosting provider's SMTP credentials.
# Examples for common shared hosting:
#
# Roundcube / cPanel:
#   SMTP_HOST=mail.sadenia.com
#   SMTP_PORT=587
#   SMTP_USER=noreply@sadenia.com
#   SMTP_PASS=your_email_password
#
# Gmail (alternative):
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_USER=your@gmail.com
#   SMTP_PASS=your_app_password
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=Sadenia Systems
SMTP_FROM_EMAIL=
SMTP_TO_EMAIL=info@sadenia.com

# -----------------------------------------------------------------------------
# Analytics — Google Analytics
# -----------------------------------------------------------------------------
# Get your Measurement ID from https://analytics.google.com
# Format: G-XXXXXXXXXX
NEXT_PUBLIC_GA_ID=

# -----------------------------------------------------------------------------
# Site URL (used for sitemap, metadata, redirects)
# -----------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://www.sadenia.com
